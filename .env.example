# Copy to .env and fill in. .env is git-ignored.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# MongoDB with authentication (default without credentials: mongodb://localhost:27017/wallet)
MONGODB_URI=mongodb://admin:<password>@localhost:27017/wallet?authSource=admin
# Optional overrides
# ACCOUNTS_BASE_URL=http://localhost:8082
